# Пример переменных окружения. Скопируйте в .env и поменяйте значения.
# Файл .env в git не коммитится.

DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# В проде добавьте свой домен с https://
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Локально в Docker HTTPS нет, поэтому редирект выключен. В проде — 1
DJANGO_SECURE_SSL_REDIRECT=0

# Премодерация объявлений: 1 — новые объявления видны только после одобрения
LISTINGS_PREMODERATION=0

# Через сколько дней пропущенные карточки снова появляются в ленте
FEED_RESURFACE_PASSED_AFTER_DAYS=14

# Сколько жалоб от разных людей скрывают анкету до проверки
AUTO_HIDE_AFTER_REPORTS=3

LOG_LEVEL=INFO
